# Pulse Chat Backend - Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit the real .env file to Git.

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# GIPHY API for GIF integration
GIPHY_API_KEY=your_giphy_api_key

# Room & Admin Passwords (use strong, unique values in production)
ADMIN_PASSWORD=your_super_admin_password
CLIENT_PASSWORD=your_client_room_password

# Database Connection
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<appName>"

# Security & Sessions
ADMIN_SECRET=your_admin_secret_key
SESSION_SECRET=your_independent_session_signing_secret_hex

# Azure App Service & Server Configuration
PORT=8080
WEBSITE_HTTPLOGGING_RETENTION_DAYS=30
ALLOWED_ORIGINS=http://localhost:3000

